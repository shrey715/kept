# ---------------------------------------------------------------------------
# Data: customer data never goes into git. Only READMEs and .gitkeep files do.
# ---------------------------------------------------------------------------
data/**
!data/
!data/*/
!data/README.md
!data/**/.gitkeep
*.duckdb
*.duckdb.wal
*.parquet
*.csv
!benchmarks/*.csv
!submission/*.csv
!tests/fixtures/**/*.csv
*.jsonl
!tests/fixtures/**/*.jsonl
*.lance/
.claude/*

# Model artefacts and experiment tracking
mlruns/
mlflow.db
mlartifacts/
*.lgb
*.pkl
*.joblib
feature_repo/data/
feature_repo/registry.db
feature_repo/online_store.db

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml

# Soda
soda/.soda/

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Notebooks
.ipynb_checkpoints/


# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# Logs (audit log in dev is local; prod is append-only storage)
logs/
*.log

# LaTeX build leftovers (reports, deck, architecture)
*.aux
*.nav
*.snm
*.toc
*.out
docs/**/*.log

# Private files: never committed or pushed (put anything personal here)
private/

# Demo and video work (captures, renders, recordings)
demo-output/
brag-output/
*.mp4
*.mov
*.webm
demo_script*.md
benchmark_questions_extra.xlsx
submission/*.json
# LaTeX build files (docs/deck/kept.pdf is committed)
docs/deck/*.aux
docs/deck/*.log
docs/deck/*.nav
docs/deck/*.out
docs/deck/*.snm
docs/deck/*.toc
docs/deck/*.vrb
