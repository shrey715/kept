# Copy to .env and fill in. Never commit .env.

# --- LLM gateway (LiteLLM). Swap hosted <-> local by changing the model string.
KEPT_LLM_MODEL=anthropic/claude-sonnet-5-5
ANTHROPIC_API_KEY=
# KEPT_LLM_MODEL=ollama/llama3.1   # local fallback

# --- Paths
KEPT_WAREHOUSE_PATH=data/warehouse/kept.duckdb
KEPT_RAW_DIR=data/raw
KEPT_EXPORT_DIR=data/exports
KEPT_AUDIT_LOG_PATH=data/warehouse/audit.duckdb
KEPT_LANCEDB_DIR=data/policy/lancedb

# --- MLflow
MLFLOW_TRACKING_URI=file:./mlruns

# --- Safety
# When true, NBA falls back to nba_recommendation_last (the current strategy).
KEPT_KILL_SWITCH=false
# Salt for the permanent 5% hold-out assignment. Never change after go-live.
KEPT_HOLDOUT_SALT=change-me-once
