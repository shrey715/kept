# Copy to .env and fill in. Never commit .env.

# --- LLM gateway (LiteLLM). Free models only (TEAM_PLAN §1b, K6); one gateway per use.
# Text extraction: local model on Track C's GPU via Ollama.
KEPT_TEXT_LLM_MODEL=ollama/gemma3:12b-it-qat
OLLAMA_API_BASE=http://localhost:11434
# Collections Ask: a free hosted tier, each person on their own key (pinned: the benchmark is tuned on it).
KEPT_ASK_LLM_MODEL=gemini/gemini-3.5-flash-lite
GEMINI_API_KEY=
# spare key for the 7 PM rerun, if Gemini's daily limit bites: groq/llama-3.1-8b-instant with GROQ_API_KEY

# --- Paths
KEPT_WAREHOUSE_PATH=data/warehouse/kept.duckdb
KEPT_RAW_DIR=data/raw
KEPT_EXPORT_DIR=data/exports
KEPT_AUDIT_LOG_PATH=data/warehouse/audit.duckdb
KEPT_LANCEDB_DIR=data/policy/lancedb

# --- MLflow
# MLflow 3 refuses the file store (file:./mlruns); artifacts still go to ./mlruns
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# --- Safety
# When true, NBA falls back to nba_recommendation_last (the current strategy).
KEPT_KILL_SWITCH=false
# Salt for the permanent 5% hold-out assignment. Never change after go-live.
KEPT_HOLDOUT_SALT=change-me-once
